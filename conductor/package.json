{
  "name": "coding-tools-conductor",
  "version": "0.1.0",
  "description": "A TypeScript orchestration layer for coding-tools-mcp.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "ctc": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "coding-agent",
    "cli",
    "tui",
    "conductor",
    "ctc"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xyTom/coding-tools-mcp.git",
    "directory": "conductor"
  },
  "homepage": "https://github.com/xyTom/coding-tools-mcp/tree/main/conductor#readme",
  "bugs": {
    "url": "https://github.com/xyTom/coding-tools-mcp/issues"
  },
  "scripts": {
    "build": "tsup src/cli/index.ts --format esm --dts --clean --splitting false",
    "dev": "tsx src/cli/index.ts",
    "lint": "eslint .",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^14.0.2",
    "execa": "^9.6.1",
    "ink": "^7.1.0",
    "ink-select-input": "^6.2.0",
    "react": "^19.2.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "eslint": "^10.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.0.16"
  }
}
